{
  "include": ["client/src/App.tsx", "client/src/main.tsx", "client/src/pages/Home.tsx", "client/src/pages/NotFound.tsx", "client/src/components/ErrorBoundary.tsx", "client/src/components/ui/tooltip.tsx", "client/src/contexts/ThemeContext.tsx"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node"],
    "paths": { "@/*": ["./client/src/*"] }
  }
}
